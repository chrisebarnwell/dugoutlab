  .example{background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--seam);border-radius:6px;padding:11px 13px;margin:16px 0;}
  .example .exh{font-family:var(--mono);font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--seam);display:block;margin-bottom:7px;}
  .example .exrow{display:grid;grid-template-columns:62px 1fr;gap:8px;font-size:14px;margin:4px 0;}
