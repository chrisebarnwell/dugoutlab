    main{background:#fff;}
    .innbrief,.block,.example,.note,.field-box{background:#fff !important;color:#000 !important;border:1px solid #000 !important;}
    .blockh,.block.breath .blockh,.lessonmeta,.example .exh,.innbrief .sci b{color:#000 !important;}
    .anchorline,.lessontitle,.innbrief .quote{color:#000 !important;border-color:#000 !important;}
    input[type=text],input[type=number],textarea,.btn{display:none !important;}
    .check input{-webkit-appearance:checkbox;appearance:checkbox;}
    .art,.block p{font-size:12pt;}
  }
  #workbook{display:none;}
  .wbbtn{background:transparent;border:1px solid var(--amber);color:var(--amber);font-family:var(--mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;border-radius:5px;padding:7px 12px;cursor:pointer;}
  .wbbtn:focus-visible{outline:2px solid var(--amber);}
  @media print {
    body.printall header.board, body.printall #dashboard, body.printall #scoreboard, body.printall #player, body.printall footer .sponsor { display:none !important; }
    body.printall #workbook { display:block; font-family:Helvetica,Arial,sans-serif; color:#000; }
    #workbook .wblesson{ page-break-after:always; }
    #workbook .wbcover{ page-break-after:always; text-align:center; padding-top:28vh; }
    #workbook .wbcover h1{ font-size:34pt; margin:0 0 8pt; }
