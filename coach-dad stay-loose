  @media (max-width:560px){ .score{grid-template-columns:repeat(4,1fr);} .score .cell.head{display:none;} .stats{grid-template-columns:repeat(2,1fr);} }
  @media (prefers-reduced-motion:reduce){ *{transition:none !important;} }

  @media print {
    body{background:#fff;color:#000;font-family:Helvetica,Arial,sans-serif;}
