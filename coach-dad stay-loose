    #workbook .wbinn{ font-weight:bold; border-bottom:1px solid #000; padding-bottom:4pt; text-transform:uppercase; }
    #workbook .wbmeta{ font-size:9pt; letter-spacing:0.05em; text-transform:uppercase; }
    #workbook .wbquote{ font-style:italic; }
    #workbook .wbanchor{ font-weight:bold; border-top:1px solid #000; padding-top:6pt; margin-top:8pt; }
    #workbook .wbline{ letter-spacing:2px; color:#000; }
    #workbook p{ font-size:11pt; line-height:1.5; margin:6pt 0; }
  }
</style>
