  .anchorline{font-family:var(--display);font-weight:700;text-transform:uppercase;font-size:clamp(18px,4.4vw,24px);color:var(--clay);border-top:2px solid var(--line);margin-top:18px;padding-top:14px;letter-spacing:0.01em;}

  .wizardnav{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:22px 0 0;padding-top:16px;border-top:1px solid var(--line);}
