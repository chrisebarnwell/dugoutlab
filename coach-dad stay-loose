  .btn.primary.done{background:var(--amber);color:var(--ink);}
  .btn.ghost{background:transparent;color:var(--ink-2);border:1px solid var(--line);}
  .btn:focus-visible{outline:3px solid var(--clay);outline-offset:2px;}
  .btn.pushright{margin-left:auto;}
  .printbtn{background:transparent;border:1px solid var(--line);color:var(--ink-2);font-family:var(--mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;border-radius:5px;padding:8px 12px;cursor:pointer;}

  .setup{display:grid;gap:14px;margin:16px 0;}
  .field-box{background:var(--chalk);border:1px solid var(--line);border-radius:8px;padding:14px 16px;}
  .field-box label{font-family:var(--mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--clay);display:block;margin-bottom:7px;}
  .field-box textarea,.field-box input[type=number]{width:100%;font-family:var(--body);font-size:15px;color:var(--ink);border:1px solid var(--line);border-radius:5px;padding:9px;background:var(--paper);resize:vertical;}
