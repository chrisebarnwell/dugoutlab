  .check input{width:20px;height:20px;accent-color:var(--clay);cursor:pointer;}
  .reflect input[type=text]{width:100%;margin-top:8px;font-family:var(--body);font-size:15px;padding:9px;border:1px solid var(--line);border-radius:5px;background:var(--paper);}
